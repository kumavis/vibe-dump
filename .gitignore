node_modules/
# The assembled gallery at /dist is COMMITTED — it's what GitHub Pages deploys,
# and building it in CI got slower with every vibe. Per-package dist/ stays out:
# it's the intermediate that /dist is assembled from.
packages/*/dist/
# and the scratch dirs the single-file build makes on its way to dist/artifact.html
packages/*/dist-standalone/
packages/*/dist-embed/
# the WebLLM copy simville generates from node_modules on its way into dist/
packages/*/public/vendor/
.DS_Store
*.log
packages/*/tools/shots/
# Pacific Theatre's fixtures (tools/fake-data.mjs): synthetic, rewritten on every run
packages/pacific-theatre/test-data/
# cold-boot's narrated-cut renders: gigabytes of frames, plus the narration and mp4
packages/cold-boot/out/
# scratch harnesses used while verifying a change in a real browser
/.probe-*.mjs
/.probe/
_probe*.mjs
__probe*.mjs

# the harness's agent worktrees
/.claude/worktrees/

# Python bytecode (packages/pacific-theatre/tools/fronts)
__pycache__/
