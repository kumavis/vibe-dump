node_modules/
# Per-app dist/<slug>/ assets stay committed. Shared gallery output is generated
# from gallery/ and package metadata locally and during deployment.
/dist/index.html
/dist/gallery.css
/dist/gallery.js
/dist/gallery-model.js
/dist/apps.json
# Intermediate local app builds:
packages/*/dist/
# and the scratch dirs the single-file build makes on its way to dist/artifact.html
packages/*/dist-standalone/
packages/*/dist-embed/
# the WebLLM copy simville generates from node_modules on its way into dist/
packages/*/public/vendor/
.DS_Store
*.log
packages/*/tools/shots/
# cold-boot's narrated-cut renders: gigabytes of frames, plus the narration and mp4
packages/cold-boot/out/
# scratch harnesses used while verifying a change in a real browser
/.probe-*.mjs
/.probe/
_probe*.mjs
__probe*.mjs
# the Grand fixture tails-and-scales builds for its fortified scale and climb checks, fresh on every run
packages/tails-and-scales/sim/.fixtures/
