  "notes": {
    "voyaging": {
      "_": "No district holdings are recorded for these centuries; the genealogies name chiefs, not the lands they held."
    },
    "mailikukahi": {
      "_": "Reign-indexed and soft. Each island is shown as its own chiefdom.",
      "hawaii:Hilo": "Before ʻUmi the districts of Hawaiʻi had their own chiefs under a paramount at Waipiʻo; ʻUmi had to win them by war (Kamakau, ch. I). Shown as one chiefdom; hatch.",
      "maui:Hāna": "Fornander (p. 87) says the Hāna chiefs acknowledged the Maui ruler in Piʻilani's reign \"and perhaps during that of his father\", implying they stood apart before. Which districts went with Hāna is not recorded; Hāna and Kīpahulu shown.",
      "lanai:Lāhainā": "Lānaʻi stood to Maui as Niʻihau to Kauaʻi: independent at times, acknowledging Maui at others (Fornander, p. 95).",
      "niihau:Kona": "Niʻihau independent at times, acknowledging Kauaʻi at others (Fornander, p. 95)."
    },
    "umi": {
      "_": "Reign-indexed and soft. Hawaiʻi united under ʻUmi; Maui under Piʻilani and Kiha-a-Piʻilani, Hāna included."
    },
    "alapai": {
      "_": "Fornander's dates for the 1730s wars are estimates.",
      "molokai:Koʻolau": "Fornander (p. 289) says Peleioholani of Oʻahu brought the Koʻolau chiefs of Molokaʻi to acknowledge him about 1738, \"neither very thorough nor very lasting\". Contested; hatch.",
      "molokai:Kona": "Alapaʻinui fought the Oʻahu chiefs at Kawela but reinstated the Molokaʻi chiefs rather than annex the island (Fornander, p. 138). Contested; hatch."
    },
    "kalaniopuu": {
      "_": "Kamakau (p. 92) gives the map at Cook's arrival in 1778: Kaʻeo over Kauaʻi, Kahahana over Oʻahu and Molokaʻi, Kahekili over Maui, Lānaʻi and Kahoʻolawe.",
      "maui:Hāna": "Held by Hawaiʻi from about 1759 until Kahekili retook Kaʻuiki early in 1782 (Fornander, pp. 146, 215–217).",
      "maui:Kīpahulu": "Taken with Hāna about 1759 (Fornander, p. 146).",
      "maui:Koʻolau": "Fornander (p. 213) says Maui curtailed Hawaiʻi's holdings outside Kaʻuiki, \"more especially on the Koolau side\". Shown with Maui; contested.",
      "maui:Kaupō": "Raided by Hawaiʻi in the 1770s; shown with Maui.",
      "molokai:Kona": "Held by the Oʻahu rulers from 1764–65 until 1783 (Fornander, p. 290).",
      "molokai:Koʻolau": "Held by the Oʻahu rulers from 1764–65 until 1783 (Fornander, p. 290)."
    },
    "kahekili": {
      "_": "After Mokuʻōhai (July 1782) and Kahekili's conquest of Oʻahu (January 1783). Kamehameha held Maui briefly after Kepaniwai in 1790.",
      "hawaii:Hāmākua": "Split: Fornander (p. 311) gives \"portions of Hamakua\" to Kamehameha and the rest to Keawemauhili. Shown with Kamehameha; hatch.",
      "hawaii:Puna": "Split: part of Puna with Keawemauhili, lower Puna with Keōua (Fornander, p. 311). Shown with Keōua; hatch.",
      "hawaii:Hilo": "Keawemauhili held Hilo until he was killed about 1790; Keōua then held the east of the island until his death in 1791.",
      "kauai:Kona": "Kauaʻi under Kaʻeo, Kahekili's brother and ally, not under Kahekili."
    },
    "kamehameha": {
      "_": "From Nuʻuanu (1795). The kingdom's name and institutions grow through this era.",
      "kauai:Kona": "Independent under Kaumualiʻi until the 1810 agreement, then ruled by him under Kamehameha (Kamakau, pp. 194–197).",
      "niihau:Kona": "With Kauaʻi."
    },
    "kauikeaouli": {
      "_": "From 25 February to 31 July 1843 the kingdom was under a provisional British cession (Jarves)."
    },
    "liliuokalani": {
      "_": "The Queen reigned until 17 January 1893. The Provisional Government held power from then, and the Republic of Hawaiʻi from 4 July 1894 (P.L. 103-150)."
    },
    "coda": {
      "_": "Annexed by joint resolution in 1898; a State since 1959. P.L. 103-150 acknowledges that the 1893 overthrow was illegal, and the legitimacy of annexation remains contested. Kahoʻolawe is held by the State in trust for a future Native Hawaiian sovereign entity (UH News 2026; KIRC)."
    }
  },
