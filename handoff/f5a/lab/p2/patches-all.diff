+    const { x: cx, z: cz, hx, hz, yaw = 0 } = c.shape
+    const lo = (px, pz) => { const dx = px - cx, dz = pz - cz; return [dx * Math.cos(yaw) - dz * Math.sin(yaw), dx * Math.sin(yaw) + dz * Math.cos(yaw)] }
