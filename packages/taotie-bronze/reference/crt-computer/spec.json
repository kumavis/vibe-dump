    "unitTop":        { "expr": "parts.lid.max.1",             "expected": 139,   "tol": 1.0 },
    "bezelWidth":     { "expr": "parts.bezel.w",               "expected": 344,   "tol": 1.0 },
    "bezelAspect":    { "expr": "parts.bezel.h / parts.bezel.w", "expected": 0.901, "tol": 0.01 },
    "screenAspect":   { "expr": "parts.screen.h / parts.screen.w", "expected": 0.756, "tol": 0.01 },
    "monitorOverUnit":{ "expr": "parts.bezel.w / parts.lid.w", "expected": 0.804, "tol": 0.01 },
    "keyboardWidth":  { "expr": "parts.keyboard.w",            "expected": 404,   "tol": 1.5 },
    "standsOnPlinth": { "expr": "parts.legs.min.1",            "expected": 0,     "tol": 0.3 },
    "legCount":       { "expr": "parts.legs.count",            "expected": 4,     "tol": 0 },
    "knobCount":      { "expr": "parts.knobs.count",           "expected": 3,     "tol": 0 }
  }
