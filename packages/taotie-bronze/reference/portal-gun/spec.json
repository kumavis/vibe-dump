    "emitterOverBody": { "expr": "parts.emitter.h / parts.body.h",    "expected": 1.659, "tol": 0.03 },
    "bodyLength":      { "expr": "parts.body.w",                      "expected": 146,   "tol": 1 },
    "bodyAspect":      { "expr": "parts.body.h / parts.body.w",       "expected": 0.578, "tol": 0.02 },
    "gripLength":      { "expr": "parts.grip.h",                      "expected": 104.5, "tol": 3 },
    "gripClearOfBase": { "expr": "parts.grip.min.1",                  "expected": 32,    "tol": 4 },
    "finCount":        { "expr": "parts.fins.count",                  "expected": 3,     "tol": 0 },
    "eyeCount":        { "expr": "parts.eyes.count",                  "expected": 2,     "tol": 0 },
    "standsOnPlinth":  { "expr": "parts.stand.min.1",                 "expected": 0,     "tol": 0.3 }
  }
